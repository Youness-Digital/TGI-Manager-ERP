rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collectionName}/{documentId} {
      allow read, write: if request.auth != null
        && collectionName in [
          'clients',
          'documents',
          'sites',
          'ascenseurs',
          'paiements',
          'contrats',
          'interventions',
          'commandes',
          'mouvements_stock',
          'devis',
          'factures',
          'stock',
          'equipe',
          'settings',
          'counters'
        ];
    }
  }
}
